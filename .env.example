# Upsun API token — create one in the Upsun Console under
# My profile → API tokens. Never commit the real value.
UPSUN_API_TOKEN=

# Optional: comma-separated organization IDs to limit the dashboard to.
# Leave empty to show every organization the token's user belongs to.
UPSUN_ORGANIZATION_IDS=

# Show redeploy / backup / pause / resume buttons. These run with the token's
# permissions for anyone who can open the dashboard, so only enable this when
# the dashboard itself is access-controlled.
UPSUN_ENABLE_ACTIONS=false
